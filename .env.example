# Gemini is the only supported LLM backend.
# Use either a comma-separated list of keys (rotated) or a single key.
GEMINI_API_KEYS=

# Optional generation defaults.
ARTICRAFT_MODEL=
ARTICRAFT_THINKING_LEVEL=
ARTICRAFT_MAX_COST_USD=

# Optional Vertex AI backend (used instead of an API key when set).
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_LOCATION=
